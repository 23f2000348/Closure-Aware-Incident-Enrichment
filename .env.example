# Copy to .env and fill in. Never commit the real password.
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=lm_admin
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

ENRICH_OUT_DIR=output_clickhouse
ENRICH_LOOKBACK_HOURS=24
# Path to the engine's rules, e.g. ../sigma-engine/rules (empty = built-in SSH rules)
ENRICH_RULES_DIR=
# Empty = all tenants, each kept separate
ENRICH_TENANT_UID=
# 0 for wazuh_correlations tables created before the snapshot schema
ENRICH_CORRELATIONS_FINAL=1
